# Transport for NSW Open Data key (https://opendata.transport.nsw.gov.au)
TFNSW_API_KEY=

# LLM provider settings (see src/lib/llm.ts)
LLM_PROVIDER=google
LLM_MODEL=gemini-3.1-flash-lite-preview
LLM_API_KEY=

# Requests per client IP to /api/chat (in-memory, per server instance). 0 turns a limit off.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100

# Optional: Langfuse tracing (see src/lib/tracing.ts). Tracing is off unless both keys are set.
# Keys: Langfuse project > Settings > API Keys. Base URL: https://cloud.langfuse.com (EU),
# https://us.cloud.langfuse.com (US), or a self-hosted URL.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Defaults to NODE_ENV (development / production).
LANGFUSE_TRACING_ENVIRONMENT=
